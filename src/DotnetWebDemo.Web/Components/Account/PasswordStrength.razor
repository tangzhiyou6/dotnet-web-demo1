@* 密码强度提示：组件自带输入框（保留 name 属性以便 MVC 表单回传），输入时即时计算强度。 *@
<div class="mb-3">
    <label class="form-label" for="@($"{Name}-strength")">@Label</label>
    <input type="password" class="form-control" id="@($"{Name}-strength")" name="@Name"
           placeholder="@Placeholder" value="@Value" autocomplete="@Autocomplete"
           @oninput="OnInput" />
    <div class="password-strength mt-2">
        <div class="progress" style="height: 6px;" role="progressbar" aria-label="密码强度">
            <div class="progress-bar @_barClass" style="width: @_percent%"></div>
        </div>
        <div class="d-flex justify-content-between mt-1">
            <small class="text-secondary">密码强度</small>
            <small class="@_textClass fw-semibold">@_label</small>
        </div>
        @if (!string.IsNullOrEmpty(_hint))
        {
            <div class="small text-secondary mt-1">@_hint</div>
        }
    </div>
</div>

@code {
    private int _percent;
    private string _label = "未输入";
    private string _barClass = "bg-secondary";
    private string _textClass = "text-secondary";
    private string? _hint;

    /// <summary>表单字段名，需与 MVC 视图模型的属性名一致。</summary>
    [Parameter] public string Name { get; set; } = "Password";

    /// <summary>显示在标签上的文字。</summary>
    [Parameter] public string Label { get; set; } = "密码";

    [Parameter] public string Placeholder { get; set; } = "请输入密码";

    [Parameter] public string Autocomplete { get; set; } = "new-password";

    /// <summary>当前密码值。</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>密码值变化回调。</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    protected override void OnParametersSet()
    {
        Evaluate(Value);
    }

    private async Task OnInput(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        await ValueChanged.InvokeAsync(value);
        Evaluate(value);
    }

    private void Evaluate(string? password)
    {
        if (string.IsNullOrEmpty(password))
        {
            _percent = 0;
            _label = "未输入";
            _barClass = "bg-secondary";
            _textClass = "text-secondary";
            _hint = null;
            return;
        }

        var score = 0;
        if (password.Length >= 8) score++;
        if (password.Length >= 12) score++;
        if (password.Any(char.IsUpper) && password.Any(char.IsLower)) score++;
        if (password.Any(char.IsDigit)) score++;
        if (password.Any(c => !char.IsLetterOrDigit(c))) score++;

        (_percent, _label, _barClass, _textClass) = score switch
        {
            <= 1 => (20, "很弱", "bg-danger", "text-danger"),
            2 => (40, "弱", "bg-danger", "text-danger"),
            3 => (60, "中等", "bg-warning", "text-warning"),
            4 => (80, "较强", "bg-info", "text-info"),
            _ => (100, "很强", "bg-success", "text-success")
        };

        _hint = BuildHint(password);
    }

    private static string? BuildHint(string password)
    {
        var hints = new List<string>();
        if (password.Length < 8) hints.Add("至少 8 位");
        if (!password.Any(char.IsUpper)) hints.Add("包含大写字母");
        if (!password.Any(char.IsLower)) hints.Add("包含小写字母");
        if (!password.Any(char.IsDigit)) hints.Add("包含数字");
        if (!password.Any(c => !char.IsLetterOrDigit(c))) hints.Add("包含特殊字符");

        return hints.Count == 0 ? null : "建议：" + string.Join("、", hints);
    }
}
