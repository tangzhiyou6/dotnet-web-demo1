@{
    ViewData["Title"] = "首页";
}

<div class="mb-4">
    <h1 class="h3 mb-2">欢迎使用 Blazor + MVC 用户系统</h1>
    <p class="text-secondary mb-0">
        ASP.NET Core MVC 负责路由、登录与页面渲染；页面内嵌的 Blazor Server 组件负责实时交互。
    </p>
</div>

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="alert alert-success d-flex flex-wrap align-items-center gap-2">
        <i class="bi bi-check-circle-fill"></i>
        <span>你好，<strong>@User.Identity!.Name</strong>，你已登录。</span>
        <a class="btn btn-sm btn-success ms-auto" asp-controller="Users" asp-action="Index">前往用户管理</a>
    </div>
}
else
{
    <div class="alert alert-info d-flex flex-wrap align-items-center gap-2">
        <i class="bi bi-info-circle-fill"></i>
        <span>你尚未登录，登录后可访问用户管理页面。</span>
        <a class="btn btn-sm btn-primary ms-auto" asp-controller="Account" asp-action="Login">去登录</a>
    </div>
}

@* 下方为内嵌的 Blazor Server 组件 *@
<component type="typeof(DotnetWebDemo.Web.Components.Home.Dashboard)"
           render-mode="ServerPrerendered" />

@section Scripts {
    <script src="_framework/blazor.web.js"></script>
}
